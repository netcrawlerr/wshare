<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="wwwroot\" />
    </ItemGroup>

    <Target Name="CreateDownloadDirectory" BeforeTargets="Build">
      <Message Importance="high" Text="Ensuring 'downloads' directory exists..." />
      <MakeDir Directories="$(ProjectDir)downloads" />
    </Target>

</Project>
